{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ],
  "compilerOptions": {
    "strict": false,            // 关闭严格模式
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node","vite/client"]
  }
}
